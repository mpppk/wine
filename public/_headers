# Cloudflare Workers Static Assets のカスタムヘッダ(#33)。
# ビルド出力(dist/client)へ public/ 配下のファイルとしてコピーされ配信される。

# HTML はこのファイルでキャッシュ対象にしない。SSR の本文・<html lang>・head は
# wine_locale Cookie で変わるため、HTML のキャッシュルールを追加する場合は
# `Vary: Cookie` (またはURL分離)を先に設計する(#536)。現在のSSRレスポンスには
# src/routes/__root.tsx から Vary: Cookie を付けている。

# Vite が出力するアセットはファイル名にコンテンツハッシュを含むため、内容が変われば
# 別URLになる。長期不変キャッシュにしてよい(再訪・ページ遷移での再検証を無くす)。
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  # MCP Apps ホストのサンドボックス iframe(allow-same-origin 無し)から
  # /embed/* を開くと、その文書は不透明オリジンになる。module script は常に
  # CORS モードで取得されるため、ACAO が無いと自分のバンドルすら読めず
  # ハイドレーションできない(#189)。アセットは公開の静的ファイルなので * でよい。
  Access-Control-Allow-Origin: *

# AOP境界データ(GeoJSON)。ファイル名にハッシュを持たないため immutable にはできないが、
# 更新頻度は低い。1日はそのまま使い、以降1週間は stale-while-revalidate で
# バックグラウンド更新にして、地図の再訪・地域切替ごとの再検証リクエストを減らす。
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  # /assets/* と同じ理由。MCP Apps ホストの sandbox iframe から開いた /embed/map は
  # 不透明オリジンになり、自オリジンの GeoJSON の取得すらクロスオリジン扱いになる。
  # ACAO が無いと fetch が CORS で弾かれ、ベースマップだけが出て AOP ポリゴンが
  # 1つも描画されない(#194)。公開の静的データなので * でよい。
  Access-Control-Allow-Origin: *

/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wine",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// 既定の `@tanstack/react-start/server-entry` ではなく自前のエントリを指す(#460)。
	// `fetch` と並べてキュー・コンシューマ(`queue`)を export する必要があるため。
	// 既定エントリの実体は数行(`createStartHandler(defaultStreamHandler)` を包むだけ)で、
	// src/worker.ts がそれをそのまま写した上で `queue` を併設している。
	"main": "src/worker.ts",
	"vars": {
		// 公開URLの単一情報源。MCP ツールが外部に返す geojson_url / map_url /
		// 署名付き photo_url と、OAuth の issuer・各エンドポイント(RFC 8414/9728 の
		// .well-known)がこの値から組まれる。カスタムドメインを公開URLにしている以上、
		// ここも同じホストにしないと discovery の issuer が実際の origin と食い違う(#270)。
		// 変更したら src/lib/auth.ts の trustedOrigins にも同じホストを登録すること。
		"BETTER_AUTH_URL": "https://wine.nibo.sh",
		// アフィリエイトID(公開情報)。実IDに差し替えるか `wrangler secret put` で上書きする。
		// 空のままでも購入リンクは素の検索URLとして機能する。
		"RAKUTEN_AFFILIATE_ID": "",
		"MOSHIMO_AMAZON_A_ID": "",
		// Stripe の price ID(公開情報)。ライブモードの terraform/production の apply 出力より。
		// 空のままでもアプリは動作し、料金ページの購入ボタンが無効化されるだけ。
		// なお STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET は terraform-apply ワークフローが投入する。
		// 期間延長コード CAMPAIGN_EXTENSION_CODES は推測悪用を防ぐためシークレット扱い
		// (`wrangler secret put CAMPAIGN_EXTENSION_CODES`)。vars には置かない。
		"STRIPE_PRICE_ID_MONTHLY": "price_1TrqGhDizKHip7Oq7IEluLkB",
		"STRIPE_PRICE_ID_ANNUAL": "price_1TrqGhDizKHip7OqMpLZc7wH"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wine-db",
			"database_id": "c79413ae-ab1e-46a0-ba80-b195422deca5",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "AVATARS",
			"bucket_name": "avatars-wine"
		}
	],
	// Workers AI(地域Q&Aの推論)。アカウントレベルのリソースのため env ごとの id は不要。
	"ai": {
		"binding": "AI"
	},
	// 画像変換(エチケット解析の zoom_photo)。アカウントレベルのリソースのため
	// env ごとの id は不要。
	//
	// **なぜ要るか**: エチケット解析の精度は「ラベルの文字が読めるか」で決まり、ボトル
	// 全体が写った写真では原寸(2180px)を送っても読めない —— プロバイダが画像を内部で
	// 縮小するため。実測では、ラベル部分を切り出して初めて生産者名を特定できた。
	// 任意領域のクロップが要るので、変換をここで行う(src/lib/images/transform.ts)。
	"images": {
		"binding": "IMAGES"
	},
	// アプリ側エンドポイントのスロットル(#397)。エッジのカウンタで判定するので
	// D1/KV を消費しない。**period は 10 か 60 秒のみ**・カウンタは colo ごと
	// (全世界で厳密に N 回ではない)という性質は src/lib/rate-limit.ts を参照。
	// namespace_id はアカウント内で一意な正整数の文字列。
	// エチケット解析ジョブ(#460)。producer(投入API)と consumer(src/worker.ts の
	// `queue`)を**同じワーカーに同居**させる。別ワーカーを立てないのは、コンシューマが
	// 使うのが D1・R2・AI・画像変換とアプリ本体と同じバインディング群で、分けると
	// 全て二重に設定することになるため。
	//
	// **env ごとに再掲が必要**(d1_databases / r2_buckets / ratelimits と同じ扱い)。
	// キュー自体は本番・preview で別リソースにする(プレビューの試行が本番のジョブを
	// 消費しない)。
	"queues": {
		"producers": [
			{
				"binding": "LABEL_JOBS",
				"queue": "wine-label-jobs"
			}
		],
		"consumers": [
			{
				"queue": "wine-label-jobs",
				// 1メッセージ = 1解析(実測30秒前後)。バッチを大きくしても直列に回すだけ
				// なので、`max_batch_timeout` で滞留を作らない小さめの値にする。
				"max_batch_size": 5,
				"max_batch_timeout": 5,
				// **リトライしない**。コンシューマ側の claim ガード(`queued` の間だけ掴む)に
				// より再配信は必ず空振りし、失敗はジョブ行に記録済みで利用者にも見える。
				// 無駄な再配信で原価と枠を消費しないよう 0 にする。
				"max_retries": 0
			}
		]
	},
	"ratelimits": [
		{
			// server function の書き込み全般。通常操作(連続保存・一括登録)を妨げない幅を取る。
			"name": "RATE_LIMIT_WRITE",
			"namespace_id": "1001",
			"simple": { "limit": 120, "period": 60 }
		},
		{
			// 画像アップロード(R2 書き込み)。1エントリ最大6枚を数回ぶん通す想定。
			"name": "RATE_LIMIT_UPLOAD",
			"namespace_id": "1002",
			"simple": { "limit": 30, "period": 60 }
		},
		{
			// 任意URLへの外部fetch。送信リレーとして悪用されうるので最も厳しくする。
			"name": "RATE_LIMIT_FETCH_TITLE",
			"namespace_id": "1003",
			"simple": { "limit": 20, "period": 60 }
		}
	],
	"env": {
		"preview": {
			"name": "wine-preview",
			"vars": {
				"BETTER_AUTH_URL": "https://wine-preview.niboshi.workers.dev",
				"RAKUTEN_AFFILIATE_ID": "",
				"MOSHIMO_AMAZON_A_ID": "",
				// preview はテストモードの price ID を設定する(本番と分離)。
				// terraform/preview の apply 出力(Terraform Apply ワークフローの Summary)より。
				"STRIPE_PRICE_ID_MONTHLY": "price_1TreYADizKHip7Oqhgu3GfeF",
				"STRIPE_PRICE_ID_ANNUAL": "price_1TreYADizKHip7Oqe42XBh2x"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "wine-preview-db",
					"database_id": "843d94a3-8558-459b-a97b-86510057bd54",
					"migrations_dir": "drizzle"
				}
			],
			"r2_buckets": [
				{
					"binding": "AVATARS",
					"bucket_name": "avatars-wine-preview"
				}
			],
			"ai": {
				"binding": "AI"
			},
			// 画像変換(zoom_photo)。本番と同じくアカウントレベルのリソース。
			"images": {
				"binding": "IMAGES"
			},
			// エチケット解析ジョブ(#460)。**キューは本番と別リソース**にする
			// (プレビューの試行が本番のジョブを消費しない)。全プレビュー環境が共通の
			// D1 を共有するのと同じく、このキューも全プレビューで共通になる。
			"queues": {
				"producers": [
					{
						"binding": "LABEL_JOBS",
						"queue": "wine-label-jobs-preview"
					}
				],
				"consumers": [
					{
						"queue": "wine-label-jobs-preview",
						"max_batch_size": 5,
						"max_batch_timeout": 5,
						"max_retries": 0
					}
				]
			},
			// **env ごとに再掲が必要**(ratelimits はトップレベル設定を継承しない。
			// d1_databases / r2_buckets / ai と同じ扱い)。namespace_id は本番と
			// 分ける必要はないが、プレビューの試行が本番のカウンタに混ざらないよう
			// 別番号にしておく。
			"ratelimits": [
				{
					"name": "RATE_LIMIT_WRITE",
					"namespace_id": "2001",
					"simple": { "limit": 120, "period": 60 }
				},
				{
					"name": "RATE_LIMIT_UPLOAD",
					"namespace_id": "2002",
					"simple": { "limit": 30, "period": 60 }
				},
				{
					"name": "RATE_LIMIT_FETCH_TITLE",
					"namespace_id": "2003",
					"simple": { "limit": 20, "period": 60 }
				}
			]
		}
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}

# .dev.vars の作り方(2通り):
#   A) 1Password(推奨): `bun run dev:vars`
#      wine vault にある値(OPENROUTER_API_KEY・STRIPE_SECRET_KEY)は下の
#      1Password 参照から自動展開される。vault に無い値は空のまま出るので、手動で埋める。
#   B) 手動: このファイルを .dev.vars にコピーし、1Password 参照の箇所を実値に置き換える。
#      (A は `op inject -i .dev.vars.example -o .dev.vars` と同じ。op 単体でも可)
# OpenAI / Anthropic のキーは使わない(全AI機能は OpenRouter 経由。#602)。
BETTER_AUTH_URL=http://localhost:3000

# better-auth のセッションCookie署名・OAuthトークン生成に使う必須シークレット。
# 本番/プレビューは `wrangler secret put BETTER_AUTH_SECRET` で投入する。ローカルは
# 任意のランダム文字列でよい(例: `bunx --bun @better-auth/cli secret` で生成)。
BETTER_AUTH_SECRET=

# アフィリエイトID(任意)。未設定なら購入リンクは素の検索URLになる。
# RAKUTEN_AFFILIATE_ID=0a1b2c3d.e4f5a6b7.0a1b2c3d.e4f5a6b8
# MOSHIMO_AMAZON_A_ID=1234567
RAKUTEN_AFFILIATE_ID=
MOSHIMO_AMAZON_A_ID=

# Stripe(任意)。未設定でもアプリは動作し、料金ページの購入ボタンが無効化される。
# STRIPE_SECRET_KEY はテストモードのシークレットキー(sk_test_...)を設定する。
# 1Password 利用時は wine vault の STRIPE_SANDBOX_KEY から展開される
# (`bun run dev:vars`)。手動運用なら 1Password 参照を実値に置換する。
# STRIPE_WEBHOOK_SECRET は `stripe listen --forward-to http://localhost:3000/api/auth/stripe/webhook`
# が表示する whsec_... を設定する(wine vault には無いので手動で設定)。
STRIPE_SECRET_KEY="op://wine/STRIPE_SANDBOX_KEY/password"
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# 全AI機能(地域Q&A・エチケット解析・ワインリスト解析)のLLM呼び出しは
# OpenRouter 経由で実行する(#602)。このキーが無い環境ではAI機能は予約の前に
# 利用不可として扱う(503 / blocked)。OpenAI / Anthropic への個別接続は廃止した。
# 既定の解析エンジンは GPT-5.6 Luna で、ユーザはプロフィール画面で切り替えられる。
# 1Password 利用時は wine vault の "OpenRouter API Key - wine" から展開される
# (`bun run dev:vars`)。手動運用なら 1Password 参照を実値に置換する。
# 本番/プレビューは `wrangler secret put OPENROUTER_API_KEY`(プレビューは --env preview)。
OPENROUTER_API_KEY="op://wine/OpenRouter API Key - wine/credential"

# 既存プレミアム会員の「期間延長」キャンペーンコード(任意)。"CODE=延長日数" を
# カンマ区切りで指定する。会員が profile ページで入力すると契約期間が延長される。
# 例: CAMPAIGN_EXTENSION_CODES=WINE7=7,SUMMER=14
CAMPAIGN_EXTENSION_CODES=

# Langfuse（任意）。AI 推論の入出力（プロンプト/応答）を追う LLM 可観測性と、
# プロンプト管理（#512 Phase 4。`region-qa-system` の本文の正は Langfuse 側）。
# 未設定なら計装もプロンプト取得も no-op（アプリは壊れず、コードの fallback で動く）。
# ローカルで試す場合は
# https://jp.cloud.langfuse.com でプロジェクトを作り、pk-lf-... / sk-lf-... を入れる。
# 本番/プレビューは `wrangler secret put LANGFUSE_PUBLIC_KEY` /
# `wrangler secret put LANGFUSE_SECRET_KEY`（プレビューは --env preview）。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
